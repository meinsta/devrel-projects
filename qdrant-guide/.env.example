# Qdrant instance with indexed docs/code for search tool
# Collection needs dense vectors (jina-code 768d) + text index on "content"
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=<your-qdrant-api-key>
QDRANT_COLLECTION=qdrant-docs

# Optional: override default skills directory
# QDRANT_SKILLS_DIR=/path/to/qdrant-skills

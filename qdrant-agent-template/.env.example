# Qdrant Cloud
QDRANT_URL=https://your-cluster.cloud.qdrant.io:6333
QDRANT_API_KEY=<your-qdrant-api-key>

# Anthropic (both tiers use Claude)
ANTHROPIC_API_KEY=<your-anthropic-api-key>

# LLM Models
LLM_CHEAP_MODEL=claude-3-5-haiku-20241022
LLM_STRONG_MODEL=claude-3-5-sonnet-20241022

# Reranker (pick one)
RERANKER_PROVIDER=jina
JINA_API_KEY=<your-jina-api-key>
COHERE_API_KEY=<your-cohere-api-key>

# Web Search (Linkup - for real-time internet access)
# Get your API key at https://app.linkup.so
LINKUP_API_KEY=<your-linkup-api-key>

# QCI Dense Model (hosted by Qdrant Cloud)
QCI_DENSE_MODEL=sentence-transformers/all-MiniLM-L6-v2
QCI_DENSE_SIZE=384

# App
PORT=3489
NODE_ENV=development
